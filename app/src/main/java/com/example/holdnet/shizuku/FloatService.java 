package com.example.holdnet.shizuku;

import android.app.Notification;
import android.app.NotificationChannel;
import android.app.NotificationManager;
import android.app.PendingIntent;
import android.app.Service;
import android.content.Intent;
import android.graphics.Color;
import android.graphics.PixelFormat;
import android.graphics.drawable.GradientDrawable;
import android.os.Build;
import android.os.IBinder;
import android.view.Gravity;
import android.view.MotionEvent;
import android.view.ViewConfiguration;
import android.view.WindowManager;
import android.widget.TextView;
import android.widget.Toast;
import rikka.shizuku.Shizuku;

import java.io.BufferedReader;
import java.io.InputStreamReader;
import java.lang.reflect.Method;

public class FloatService extends Service {

    private WindowManager wm;
    private TextView ball;
    private GradientDrawable ballBg;
    private WindowManager.LayoutParams lp;

    private boolean holding = false;
    private boolean originalWifi = false;
    private boolean originalMobileData = false;

    private float downX, downY;
    private int originX, originY;
    private boolean dragging = false;
    private int slop;

    @Override
    public IBinder onBind(Intent intent) {
        return null;
    }

    @Override
    public void onCreate() {
        super.onCreate();
        startForegroundCompat();
        wm = (WindowManager) getSystemService(WINDOW_SERVICE);
        slop = ViewConfiguration.get(this).getScaledTouchSlop();
        createBall();
    }

    private void startForegroundCompat() {
        String channelId = "float_ball";
        if (Build.VERSION.SDK_INT >= 26) {
            NotificationManager nm = (NotificationManager) getSystemService(NOTIFICATION_SERVICE);
            nm.createNotificationChannel(new NotificationChannel(channelId, "悬浮球服务",
                    NotificationManager.IMPORTANCE_LOW));
        }
        PendingIntent pi = PendingIntent.getActivity(this, 0,
                new Intent(this, MainActivity.class), PendingIntent.FLAG_IMMUTABLE);
        Notification n = new Notification.Builder(this, channelId)
                .setContentTitle("按住断网 已运行")
                .setContentText("Shizuku 模式：按住断网，松开恢复")
                .setSmallIcon(android.R.drawable.ic_dialog_info)
                .setContentIntent(pi)
                .setOngoing(true)
                .build();

        if (Build.VERSION.SDK_INT >= 29) {
            try {
                Method m = Service.class.getMethod("startForeground",
                        int.class, Notification.class, int.class);
                m.invoke(this, 1, n, 1073741824);
            } catch (Exception e) {
                startForeground(1, n);
            }
        } else {
            startForeground(1, n);
        }
    }

    private int dp(int v) {
        return (int) (v * getResources().getDisplayMetrics().density);
    }

    private void createBall() {
        ballBg = new GradientDrawable();
        ballBg.setShape(GradientDrawable.OVAL);
        ballBg.setColor(0xCC1677FF);

        ball = new TextView(this);
        ball.setText("🌐");
        ball.setTextColor(Color.WHITE);
        ball.setTextSize(24f);
        ball.setGravity(Gravity.CENTER);
        ball.setBackground(ballBg);
        ball.setOnTouchListener((v, e) -> onTouchBall(e));

        int size = dp(76);
        lp = new WindowManager.LayoutParams(size, size,
                WindowManager.LayoutParams.TYPE_APPLICATION_OVERLAY,
                WindowManager.LayoutParams.FLAG_NOT_FOCUSABLE,
                PixelFormat.TRANSLUCENT);
        lp.gravity = Gravity.TOP | Gravity.START;
        lp.x = getResources().getDisplayMetrics().widthPixels - size - dp(12);
        lp.y = dp(200);
        wm.addView(ball, lp);
    }

    private boolean onTouchBall(MotionEvent e) {
        switch (e.getActionMasked()) {
            case MotionEvent.ACTION_DOWN:
                downX = e.getRawX();
                downY = e.getRawY();
                originX = lp.x;
                originY = lp.y;
                dragging = false;
                beginHold();
                return true;
            case MotionEvent.ACTION_MOVE:
                float dx = e.getRawX() - downX;
                float dy = e.getRawY() - downY;
                if (Math.hypot(dx, dy) > slop) {
                    if (holding) endHold();
                    dragging = true;
                    lp.x = (int) (originX + dx);
                    lp.y = (int) (originY + dy);
                    lp.x = Math.max(0, Math.min(lp.x, getResources().getDisplayMetrics().widthPixels - lp.width));
                    lp.y = Math.max(0, Math.min(lp.y, getResources().getDisplayMetrics().heightPixels - lp.height));
                    try { wm.updateViewLayout(ball, lp); } catch (Exception ignored) {}
                }
                return true;
            case MotionEvent.ACTION_UP:
            case MotionEvent.ACTION_CANCEL:
                if (!dragging) endHold();
                dragging = false;
                return true;
        }
        return false;
    }

    private void beginHold() {
        if (holding) return;
        holding = true;
        originalWifi = getSetting("wifi_on") == 1;
        originalMobileData = getSetting("mobile_data") == 1;
        execShell("svc wifi disable");
        execShell("svc data disable");
        ball.setText("断网");
        ballBg.setColor(0xCCD93025);
    }

    private void endHold() {
        if (!holding) return;
        holding = false;
        execShell("svc wifi " + (originalWifi ? "enable" : "disable"));
        execShell("svc data " + (originalMobileData ? "enable" : "disable"));
        ball.setText("🌐");
        ballBg.setColor(0xCC1677FF);
    }

    private int getSetting(String key) {
        try {
            Process process = Shizuku.newProcess(new String[]{"settings", "get", "global", key}, null, null);
            BufferedReader reader = new BufferedReader(new InputStreamReader(process.getInputStream()));
            String result = reader.readLine();
            process.waitFor();
            return result != null ? Integer.parseInt(result.trim()) : 0;
        } catch (Exception e) {
            return 0;
        }
    }

    private void execShell(String cmd) {
        try {
            Process process = Shizuku.newProcess(new String[]{"sh", "-c", cmd}, null, null);
            process.waitFor();
        } catch (Exception e) {
            Toast.makeText(this, "Shizuku 执行失败: " + e.getMessage(), Toast.LENGTH_SHORT).show();
        }
    }

    @Override
    public void onDestroy() {
        endHold();
        try { wm.removeView(ball); } catch (Exception ignored) {}
        super.onDestroy();
    }
}
